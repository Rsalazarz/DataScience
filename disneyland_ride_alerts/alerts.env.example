# Disneyland ride alerts — configuration template.
# Copy to "alerts.env", fill in your values, then:
#   set -a && source alerts.env && set +a
#
# Do NOT commit your real alerts.env (it contains a password). It is gitignored.

# Gmail account that SENDS the alerts (used as the SMTP login).
GMAIL_ADDRESS=youraddress@gmail.com

# A Google "App Password" (https://myaccount.google.com/apppasswords),
# NOT your normal Gmail password. 16 characters, spaces are fine.
GMAIL_APP_PASSWORD=abcd efgh ijkl mnop

# Where alerts are sent.
ALERT_RECIPIENT=rsalazarzugasti@gmail.com

# Optional tuning.
WAIT_THRESHOLD=30      # minutes — alert when wait drops under this
POLL_INTERVAL=300      # seconds between checks in --loop mode
